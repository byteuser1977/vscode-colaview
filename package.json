{
  "name": "vscode-colaview",
  "displayName": "ColaView MD",
  "version": "0.3.2",
  "publisher": "bytechain",
  "description": "ColaMD Preview — Rich Markdown Preview & PDF/HTML Export for VSCode",
  "icon": "icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/bytechain/vscode-colaview.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onLanguage:markdown",
    "onCommand:colaview.showPreview",
    "onCommand:colaview.exportPDF",
    "onCommand:colaview.exportHTML",
    "onCommand:colaview.exportWord"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "colaview.showPreview",
        "title": "Show Preview",
        "icon": "$(open-preview)"
      },
      {
        "command": "colaview.exportPDF",
        "title": "Export to PDF...",
        "icon": "$(export)"
      },
      {
        "command": "colaview.exportHTML",
        "title": "Export to HTML...",
        "icon": "$(export)"
      },
      {
        "command": "colaview.exportWord",
        "title": "Export to Word...",
        "icon": "$(export)"
      },
      {
        "command": "colaview.switchTheme",
        "title": "Switch Preview Theme..."
      },
      {
        "command": "colaview.importTheme",
        "title": "Import Custom Theme..."
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "colaview.showPreview",
          "group": "navigation"
        }
      ],
      "editor/context": [
        {
          "command": "colaview.showPreview",
          "group": "1_colaview"
        },
        {
          "command": "colaview.exportPDF",
          "group": "1_colaview"
        },
        {
          "command": "colaview.exportHTML",
          "group": "1_colaview"
        },
        {
          "command": "colaview.exportWord",
          "group": "1_colaview"
        }
      ],
      "explorer/context": [
        {
          "command": "colaview.exportPDF",
          "group": "1_colaview"
        },
        {
          "command": "colaview.exportHTML",
          "group": "1_colaview"
        },
        {
          "command": "colaview.exportWord",
          "group": "1_colaview"
        }
      ]
    },
    "configuration": {
      "title": "ColaView MD",
      "properties": {
        "colaview.theme": {
          "type": "string",
          "default": "elegant",
          "enum": [
            "light",
            "dark",
            "elegant",
            "sepia",
            "notion",
            "bear",
            "writer",
            "solarized-dark",
            "nord",
            "gruvbox",
            "dracula",
            "midnight"
          ],
          "description": "Visual theme for preview and export"
        },
        "colaview.plugins.math": {
          "type": "boolean",
          "default": true,
          "description": "Enable KaTeX math formula rendering"
        },
        "colaview.plugins.mermaid": {
          "type": "boolean",
          "default": true,
          "description": "Enable Mermaid diagram rendering"
        },
        "colaview.pdfMethod": {
          "type": "string",
          "default": "puppeteer",
          "enum": [
            "puppeteer",
            "webviewPrint"
          ],
          "description": "PDF export method"
        },
        "colaview.autoPreview": {
          "type": "boolean",
          "default": false,
          "description": "Auto show preview on opening Markdown"
        },
        "colaview.customThemesPath": {
          "type": "string",
          "default": "",
          "description": "Custom theme CSS directory path"
        },
        "colaview.scrollSync": {
          "type": "boolean",
          "default": false,
          "description": "Enable scroll sync between editor and preview"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run esbuild-base -- --production",
    "esbuild-base": "node esbuild.js",
    "build": "node esbuild.js",
    "watch": "node esbuild.js --watch",
    "pretest": "npm run build",
    "test": "node ./out/test/runTest.js",
    "package": "vsce package",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@bytechain.cn/colamd": "2.7.11",
    "docx": "^9.15.2",
    "katex": "^0.16.47",
    "mermaid": "^11.15.0",
    "puppeteer-core": "^25.1.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5"
  },
  "devDependencies": {
    "@types/katex": "^0.16.8",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.85.0",
    "@vscode/test-electron": "^2.4.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.28.0",
    "eslint": "^9.0.0",
    "patch-package": "^8.0.1",
    "typescript": "^5.7.0"
  }
}
